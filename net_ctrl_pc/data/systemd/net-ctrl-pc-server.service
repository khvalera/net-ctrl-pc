[Unit]
Description=Net Control PC - Server
After=network.target

[Service]
Type=simple
ExecStartPre=/usr/bin/sleep 5
ExecStart=/usr/bin/python3 -m net_ctrl_pc.server
Restart=on-failure
RestartSec=5s
User=netctrl
Group=netctrl

PermissionsStartOnly=true
WorkingDirectory=/var/lib/net-ctrl-pc
ReadWritePaths=/var/log/net-ctrl-pc

[Install]
WantedBy=multi-user.target
